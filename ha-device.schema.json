{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Home Assistant MQTT Device",
    "description": "A simple way to configure a Home Assistant device",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "description": "The name of the device",
            "type": "string"
        },
        "manufacturer": {
            "description": "The manufacturer of the device",
            "type": "string"
        },
        "model": {
            "description": "The model of the device",
            "type": "string"
        },
        "suggested_area": {
            "description": "Suggest an area if the device isn't in one yet",
            "type": "string"
        },
        "sw_version": {
            "description": "The firmware version of the device",
            "type": "string"
        },
        "availability": {
            "description": "Whether or not to tell home assistant when the device is online/offline. Default: true",
            "type": "boolean"
        },
        "identifiers": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "time": {
            "description": "Whether or not to keep track of time using the ezTime library exposing a time property as well as some functions, uses more resources and network bandwidth/data, Default: false",
            "type": "boolean"
        },
        "ota_update": {
            "description": "Whether or not to enable over-the-air firmware updates, halves available FLASH and uses more memory, Default: true",
            "type": "boolean"
        },
        "retain": {
            "description": "Whether or not mqtt messages are sent using the retain flag. Default: true",
            "type": "boolean"
        },
        "features": {
            "description": "A list of all the device's features and capabilities, e.g. Lights, Switches, Buttons, ...",
            "type": "array",
            "items": {
                "title": "Feature",
                "description": "A feature/function of the device",
                "additionalProperties": true,
                "type": "object",
                "properties": {
                    "class": {
                        "enum": [
                            "-WIP-alarm_control_panel",
                            "binary_sensor",
                            "button",
                            "-WIP-camera",
                            "-WIP-cover",
                            "-WIP-device_tracker",
                            "device_trigger",
                            "-WIP-fan",
                            "-WIP-humidifier",
                            "-WIP-climate",
                            "light",
                            "lock",
                            "number",
                            "scene",
                            "select",
                            "sensor",
                            "switch",
                            "-WIP-tag_scanner",
                            "-WIP-vacuum"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "var_name": {
                        "type": "string"
                    },
                    "unique_id": {
                        "type": "string"
                    },
                    "retain": {
                        "description": "Whether or not mqtt messages are sent using the retain flag. Default: Taken from device.availability, which defaults to true",
                        "type": "boolean"
                    },
                    "icon": {
                        "type": "string"
                    }
                },
                "required": [
                    "class",
                    "name",
                    "unique_id"
                ],
                "oneOf": [
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "binary_sensor"
                                ]
                            },
                            "expire_after": {
                                "description": "Time in Seconds",
                                "type": "integer"
                            },
                            "off_delay": {
                                "description": "Time in Seconds",
                                "type": "integer"
                            },
                            "force_update": {
                                "type": "boolean"
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "button"
                                ]
                            },
                            "retain": {
                                "type": "null"
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "light"
                                ]
                            },
                            "effect_list": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            },
                            "mode": {
                                "description": "The type of light, Default: onoff",
                                "enum": [
                                    "onoff",
                                    "brightness",
                                    "color_temp",
                                    "hs",
                                    "xy",
                                    "rgb",
                                    "rgbw",
                                    "rgbww"
                                ]
                            },
                            "flash_time_long": {
                                "description": "Time in Seconds, Default: 10",
                                "type": "integer"
                            },
                            "flash_time_short": {
                                "description": "Time in Seconds, Default: 2",
                                "type": "integer"
                            },
                            "max_kelvin": {
                                "description": "Max color temperature in Kelvin, Default: 6500",
                                "type": "number"
                            },
                            "min_kelvin": {
                                "description": "Min color temperature in Kelvin, Default: 2700",
                                "type": "number"
                            },
                            "resolution": {
                                "description": "The lights brightness resolution in bit, Default: 8 (0-255)",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 32
                            }
                        },
                        "oneOf": [
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "onoff"
                                        ]
                                    },
                                    "pin": {
                                        "description": "The pin on which to output On/Off (High/Low) signals to, when light state is changed, Default: needs to be handled manually (Example Value: 'D8')",
                                        "type": "string"
                                    },
                                    "initial_state": {
                                        "description": "The initial state (on/off) the light takes on before the device connects to homeassistant, Default: false (off)",
                                        "type": "boolean"
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "brightness"
                                        ]
                                    },
                                    "pin": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal, Default: needs to be handled manually (Example Value: 'D8')"
                                    },
                                    "initial_brightness": {
                                        "description": "The initial brightness in percent (0-100) the light is set to before the device connects to homeassistant, Default: 0 (off)",
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "color_temp"
                                        ]
                                    },
                                    "pinW": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Warm White LEDs, Default: needs to be handled manually (Example Value: 'D7')"
                                    },
                                    "pinC": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Cold White LEDs, Default: needs to be handled manually (Example Value: 'D8')"
                                    },
                                    "initial_brightness": {
                                        "description": "The initial brightness in percent (0-100) the light is set to before the device connects to homeassistant, Default: 0 (off)",
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                    },
                                    "initial_temp": {
                                        "description": "The initial color temperature in kelvin the light is set to before the device connects to homeassistant, Default: 4000 (a little warm)",
                                        "type": "number",
                                        "minimum": 2000,
                                        "maximum": 6535
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "hs",
                                            "xy",
                                            "rgb",
                                            "rgbw",
                                            "rgbww"
                                        ]
                                    },
                                    "pin": {
                                        "description": "The pin on which to output digital signals to control addressable RGB Pixels (e.g. WS2812), Default: needs to be handled manually (Example Value: 'D8')",
                                        "type": "string"
                                    },
                                    "model": {
                                        "description": "The Driver Chip Model, Default: DP1903 (a cheap WS2812 variant)",
                                        "type": "string",
                                        "enum": [
                                            "would be cool to have an ENUM here, maybe just with most popular"
                                        ]
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "rgb"
                                        ]
                                    },
                                    "pinR": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Red LEDs, Default: needs to be handled manually (Example Value: 'D6')",
                                        "type": "string"
                                    },
                                    "pinG": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Green LEDs, Default: needs to be handled manually (Example Value: 'D7')",
                                        "type": "string"
                                    },
                                    "pinB": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Blue LEDs, Default: needs to be handled manually (Example Value: 'D8')",
                                        "type": "string"
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "rgbw"
                                        ]
                                    },
                                    "pinR": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Red LEDs, Default: needs to be handled manually (Example Value: 'D6')",
                                        "type": "string"
                                    },
                                    "pinG": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Green LEDs, Default: needs to be handled manually (Example Value: 'D7')",
                                        "type": "string"
                                    },
                                    "pinB": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Blue LEDs, Default: needs to be handled manually (Example Value: 'D8')",
                                        "type": "string"
                                    },
                                    "pinW": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the White LEDs, Default: needs to be handled manually (Example Value: 'D9')",
                                        "type": "string"
                                    }
                                }
                            },
                            {
                                "properties": {
                                    "mode": {
                                        "enum": [
                                            "rgbww"
                                        ]
                                    },
                                    "pinR": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Red LEDs, Default: needs to be handled manually (Example Value: 'D6')",
                                        "type": "string"
                                    },
                                    "pinG": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Green LEDs, Default: needs to be handled manually (Example Value: 'D7')",
                                        "type": "string"
                                    },
                                    "pinB": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Blue LEDs, Default: needs to be handled manually (Example Value: 'D8')",
                                        "type": "string"
                                    },
                                    "pinW": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Warm White LEDs, Default: needs to be handled manually (Example Value: 'D9')",
                                        "type": "string"
                                    },
                                    "pinC": {
                                        "description": "The pin on which to output a PWM (~16kHz) control signal for the Cold White LEDs, Default: needs to be handled manually (Example Value: 'D10')",
                                        "type": "string"
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "lock"
                                ]
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "number"
                                ]
                            },
                            "min": {
                                "type": "number"
                            },
                            "max": {
                                "type": "number"
                            },
                            "step": {
                                "type": "number"
                            },
                            "unit_of_measurement": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "scene"
                                ]
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "device_trigger"
                                ]
                            },
                            "type": {
                                "description": "Supported by frontend: button_short_press, button_short_release, button_long_press, button_long_release, button_double_press, button_triple_press, button_quadruple_press, button_quintuple_press",
                                "type": "string"
                            },
                            "subtype": {
                                "description": "turn_on, turn_off, button_1, button_2, button_3, button_4, button_5, button_6",
                                "type": "string"
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "select"
                                ]
                            },
                            "options": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "sensor"
                                ]
                            },
                            "expire_after": {
                                "description": "Time in Seconds",
                                "type": "integer"
                            },
                            "force_update": {
                                "type": "boolean"
                            },
                            "unit_of_measurement": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "properties": {
                            "class": {
                                "enum": [
                                    "switch"
                                ]
                            }
                        }
                    }
                ]
            }
        }
    },
    "required": [
        "name",
        "identifiers"
    ]
}